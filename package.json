{
  "name": "kehikko-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Questions about passages of a paper, kept as one Markdown file per epic, and what you answered. An agent writes them; a person answers them. An app: its own store, its own page, its own port. A host may frame it, and then it learns which project it is standing in and which epic is open.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "register": "bun run register.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@radix-ui/react-slot": "^1.3.3",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kehikot-module-protocol": "git+ssh://git@github.com/Jalez/kehikko-protocol.git#v0.36.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.2.4"
  }
}
